# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Gemini model overrides (defaults: gemini-4-hydrogen)
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_SEARCH_MODEL="gemini-4-hydrogen"

# Optional vision provider override: gemini | openai | manual
# When unset, auto-selects Gemini (if GEMINI_API_KEY is set), else OpenAI, else manual.
IMAGE_ANALYSIS_PROVIDER="gemini"

# Optional OpenAI Vision configuration (used if IMAGE_ANALYSIS_PROVIDER="openai")
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional upstream vision request timeout in milliseconds (5000..60000, default 25000)
AI_VISION_TIMEOUT_MS="25000"

# Optional NHTSA public API request timeout (ms, default 8000) and server cache TTL (ms, default 900000)
NHTSA_REQUEST_TIMEOUT_MS="8000"
NHTSA_CACHE_TTL_MS="900000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional overrides if not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Master Admin PIN (Server-Side Only — never prefix with VITE_)
# Used to unlock the 3-6 hour Trial PIN Generator console. If left empty in a fresh
# preview workspace, complete the one-time Admin PIN Setup flow inside the Access modal.
VECL_ADMIN_MASTER_PIN=""
