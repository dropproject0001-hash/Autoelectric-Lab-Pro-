{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated technician or trainee profile in Virtual ECU Lab.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Technician display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "BenchSession": {
      "title": "BenchSession",
      "description": "Lightweight Virtual ECU Lab bench session header; harness wires, injected faults, and sensor/actuator component states are stored in dedicated subcollections so every document is individually validated.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "ecuProfileLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "powerSupply": {
          "type": "object",
          "description": "Bench power supply configuration (voltageSetting, currentLimit, isOutputEnabled, preset)."
        },
        "activeDtcs": {
          "type": "array",
          "description": "Bounded summary list of MNA-solved OBD-II DTC strings (max 20)."
        },
        "supplyCurrentDrawAmps": {
          "type": "number",
          "description": "MNA-solved total bench supply current draw in Amperes."
        },
        "wireCount": {
          "type": "integer",
          "description": "Count of BenchSessionWire documents in /wires subcollection (0..50)."
        },
        "faultCount": {
          "type": "integer",
          "description": "Count of BenchSessionFault documents in /faults subcollection (0..20)."
        },
        "componentStateCount": {
          "type": "integer",
          "description": "Count of BenchSessionComponentState documents in /componentStates subcollection (0..40)."
        },
        "schemaVersion": {
          "type": "integer",
          "description": "Subcollection storage schema version (2)."
        },
        "selectedBrandKey": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "Optional selected vehicle make identifier."
        },
        "selectedModelName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Optional selected vehicle model name."
        },
        "selectedEcuProfileId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "Optional ECU hardware profile ID."
        },
        "rpmEmulator": {
          "type": "object",
          "description": "Optional CKP/CMP emulator state (isActive, rpm, soundEnabled, camPhaseOffsetDeg, ckpSignalLost)."
        },
        "gaugeMonitor": {
          "type": "object",
          "description": "Optional synchronized Live Gauge Console configuration and Peak-Hold history."
        },
        "multimeter": {
          "type": "object",
          "description": "Optional digital multimeter mode and probe placement state."
        },
        "workflowCheckedIds": {
          "type": "array",
          "description": "Checked Diagnostic Workflow step IDs for this bench session (max 20)."
        },
        "preBenchGateLocked": {
          "type": "boolean",
          "description": "Whether the mandatory Pre-Bench PSU Safety Gate is armed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "ecuProfileLabel",
        "powerSupply",
        "activeDtcs",
        "supplyCurrentDrawAmps",
        "wireCount",
        "faultCount",
        "componentStateCount",
        "schemaVersion",
        "createdAt",
        "updatedAt"
      ]
    },
    "BenchSessionWire": {
      "title": "BenchSessionWire",
      "description": "Individual harness wire connection document under a BenchSession.",
      "type": "object",
