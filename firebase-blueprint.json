          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourcePinId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "targetPinId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "isCut": {
          "type": "boolean"
        },
        "resistance": {
          "type": "number",
          "description": "Wire series resistance in Ohms (0..1,000,000)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "sessionId",
        "sourcePinId",
        "targetPinId",
        "color",
        "label",
        "isCut",
        "resistance",
        "createdAt",
        "updatedAt"
      ]
    },
    "BenchSessionFault": {
      "title": "BenchSessionFault",
      "description": "Individual injected electrical fault document under a BenchSession.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pinId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "faultType": {
          "type": "string",
