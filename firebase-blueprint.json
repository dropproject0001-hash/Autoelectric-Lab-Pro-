            "NONE",
            "OPEN_CIRCUIT",
            "SHORT_TO_GND",
            "SHORT_TO_VBAT",
            "HIGH_RESISTANCE_50R",
            "HIGH_RESISTANCE_250R",
            "HIGH_RESISTANCE_1K"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "timestamp": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "sessionId",
        "pinId",
        "faultType",
        "description",
        "timestamp",
        "createdAt",
        "updatedAt"
      ]
    },
    "BenchSessionComponentState": {
      "title": "BenchSessionComponentState",
      "description": "Individual bench sensor/actuator parameter state document under a BenchSession.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "componentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "object",
          "description": "Bounded key-value map of component state (throttle, pressureKpa, tempC, calibrationPreset, etc., max 24 entries)."
