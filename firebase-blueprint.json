  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private technician profile keyed by Firebase Auth UID."
    },
    "/users/{userId}/benchSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/BenchSession"
      },
      "description": "Lightweight saved ECU bench workspace headers belonging to the authenticated user."
    },
    "/users/{userId}/benchSessions/{sessionId}/wires/{wireId}": {
      "schema": {
        "$ref": "#/entities/BenchSessionWire"
      },
      "description": "Individual harness wire connection documents for a saved bench session."
    },
    "/users/{userId}/benchSessions/{sessionId}/faults/{faultId}": {
      "schema": {
        "$ref": "#/entities/BenchSessionFault"
      },
      "description": "Individual injected fault documents for a saved bench session."
    },
    "/users/{userId}/benchSessions/{sessionId}/componentStates/{componentId}": {
      "schema": {
        "$ref": "#/entities/BenchSessionComponentState"
      },
      "description": "Individual bench component parameter state documents for a saved bench session."
    },
    "/users/{userId}/diagnosticLogs/{logId}": {
      "schema": {
        "$ref": "#/entities/DiagnosticLog"
      },
      "description": "Saved diagnostic logs and grounded TSB/pinout bookmarks belonging to the authenticated user."
    },
    "/users/{userId}/diagnosticLogs/{logId}/sources/{sourceId}": {
      "schema": {
        "$ref": "#/entities/DiagnosticLogSource"
      },
      "description": "Individual grounded web search source citations for a diagnostic log."
    },
    "/users/{userId}/pcbScans/{scanId}": {
      "schema": {
        "$ref": "#/entities/PcbScan"
      },
      "description": "Saved mapped ECU PCB scan headers belonging to the authenticated user."
    },
    "/users/{userId}/pcbScans/{scanId}/components/{componentId}": {
      "schema": {
        "$ref": "#/entities/PcbScanComponent"
      },
      "description": "Individual normalized PCB component bounding box and pinout documents under a PCB scan."
    },
    "/users/{userId}/pcbScans/{scanId}/nets/{netId}": {
      "schema": {
        "$ref": "#/entities/PcbScanNet"
      },
      "description": "Individual normalized copper trace net documents under a PCB scan."
    },
    "/users/{userId}/pcbScans/{scanId}/hotspots/{hotspotId}": {
      "schema": {
        "$ref": "#/entities/PcbScanHotspot"
      },
      "description": "Individual normalized PCB fault/thermal hotspot documents under a PCB scan."
    },
    "/users/{userId}/benchPreferences/{prefId}": {
      "schema": {
        "$ref": "#/entities/BenchPreferences"
      },
      "description": "Synced per-user Diagnostic Workflow state and Pre-Bench safety gate settings."
    },
    "/users/{userId}/benchPreferences/{prefId}/voiceMacros/{macroId}": {
      "schema": {
        "$ref": "#/entities/VoiceMacroDoc"
      },
      "description": "Individual synced custom and preset Voice Macro documents under BenchPreferences."
    },
    "/users/{userId}/faultSequences/{sequenceId}": {
      "schema": {
        "$ref": "#/entities/FaultSequence"
      },
      "description": "Saved custom multi-stage Fault Builder sequence headers belonging to the authenticated user."
    },
    "/users/{userId}/faultSequences/{sequenceId}/stages/{stageId}": {
      "schema": {
        "$ref": "#/entities/FaultSequenceStage"
      },
      "description": "Individual ordered stages belonging to a saved Fault Builder sequence."
    },
    "/users/{userId}/faultSequences/{sequenceId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/FaultSequenceItem"
      },
      "description": "Individual fault items belonging to a stage in a saved Fault Builder sequence."
    }
  }
}
