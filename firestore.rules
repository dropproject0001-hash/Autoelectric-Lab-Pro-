          allow update: if isValidId(userId) && isValidId(sessionId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) &&
            isValidBenchComponentStateDoc(incoming(), userId, sessionId, componentId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().sessionId == existing().sessionId &&
            incoming().componentId == existing().componentId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly(['state', 'updatedAt']) &&
            ownsSessionAfter(userId, sessionId);
          allow delete: if isValidId(userId) && isValidId(sessionId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
        }
      }

      // Saved Diagnostic Logs & Grounded TSB Bookmarks
      match /diagnosticLogs/{logId} {
        allow get: if isValidId(userId) && isValidId(logId) && isVerified() && isOwner(userId);
        allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
