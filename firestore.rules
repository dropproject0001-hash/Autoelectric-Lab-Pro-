          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'notes', 'ecuProfileLabel', 'powerSupply',
            'activeDtcs', 'supplyCurrentDrawAmps',
            'wireCount', 'faultCount', 'componentStateCount', 'schemaVersion',
            'selectedBrandKey', 'selectedModelName', 'selectedEcuProfileId',
            'rpmEmulator', 'gaugeMonitor', 'multimeter',
            'workflowCheckedIds', 'preBenchGateLocked', 'updatedAt',
