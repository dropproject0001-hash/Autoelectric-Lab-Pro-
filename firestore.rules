            'wires', 'faults', 'componentStates'
          ]);
        allow delete: if isValidId(userId) && isValidId(sessionId) && isVerified() && isOwner(userId);

        match /wires/{wireId} {
          allow get: if isValidId(userId) && isValidId(sessionId) && isValidId(wireId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
          allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(sessionId) && isValidId(wireId) &&
            isVerified() && isOwner(userId) &&
            isValidBenchWireDoc(incoming(), userId, sessionId, wireId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            ownsSessionAfter(userId, sessionId);
          allow update: if isValidId(userId) && isValidId(sessionId) && isValidId(wireId) &&
            isVerified() && isOwner(userId) &&
            isValidBenchWireDoc(incoming(), userId, sessionId, wireId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().sessionId == existing().sessionId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'sourcePinId', 'targetPinId', 'color', 'label', 'isCut', 'resistance', 'updatedAt'
            ]) &&
            ownsSessionAfter(userId, sessionId);
          allow delete: if isValidId(userId) && isValidId(sessionId) && isValidId(wireId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
        }

        match /faults/{faultId} {
          allow get: if isValidId(userId) && isValidId(sessionId) && isValidId(faultId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
