            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'pinId', 'faultType', 'description', 'timestamp', 'updatedAt'
            ]) &&
            ownsSessionAfter(userId, sessionId);
          allow delete: if isValidId(userId) && isValidId(sessionId) && isValidId(faultId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
        }

        match /componentStates/{componentId} {
          allow get: if isValidId(userId) && isValidId(sessionId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) && ownsSessionExisting(userId, sessionId);
          allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(sessionId) && isValidId(componentId) &&
