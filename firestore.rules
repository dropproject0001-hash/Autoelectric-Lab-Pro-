        data.endOhms is number && data.endOhms >= 0.5 && data.endOhms <= 100000 &&
        data.onDurationMs is number && data.onDurationMs >= 10 && data.onDurationMs <= 30000 &&
        data.offDurationMs is number && data.offDurationMs >= 10 && data.offDurationMs <= 30000 &&
        data.intermittentEffect in ['OPEN_DROPOUT', 'SHORT_TO_GND', 'HIGH_RESISTANCE'] &&
