          allow update: if isValidId(userId) && isValidId(logId) && isValidId(sourceId) &&
            isVerified() && isOwner(userId) &&
            isValidDiagnosticLogSourceDoc(incoming(), userId, logId, sourceId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().logId == existing().logId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'uri', 'domain', 'orderIndex', 'updatedAt'
            ]) &&
            ownsLogAfter(userId, logId);
          allow delete: if isValidId(userId) && isValidId(logId) && isValidId(sourceId) &&
            isVerified() && isOwner(userId) && ownsLogExisting(userId, logId);
        }
      }

      // Saved Mapped PCB Scans (Header + Individual Validated Component / Net / Hotspot Subcollections)
      match /pcbScans/{scanId} {
        allow get: if isValidId(userId) && isValidId(scanId) && isVerified() && isOwner(userId);
        allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(scanId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidPcbScan(incoming(), userId, scanId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(scanId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidPcbScan(incoming(), userId, scanId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'boardType', 'analysisSummary', 'model',
            'componentCount', 'netCount', 'hotspotCount', 'schemaVersion', 'updatedAt',
            // Permitted solely for legacy v1 field deletion (isValidPcbScan forbids retaining them)
            'components', 'nets', 'hotspots'
          ]);
        allow delete: if isValidId(userId) && isValidId(scanId) && isVerified() && isOwner(userId);

        match /components/{componentId} {
          allow get: if isValidId(userId) && isValidId(scanId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) && ownsPcbScanExisting(userId, scanId);
          allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(scanId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) &&
            isValidPcbComponentDoc(incoming(), userId, scanId, componentId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            ownsPcbScanAfter(userId, scanId);
          allow update: if isValidId(userId) && isValidId(scanId) && isValidId(componentId) &&
            isVerified() && isOwner(userId) &&
            isValidPcbComponentDoc(incoming(), userId, scanId, componentId) &&
