            ownsPcbScanAfter(userId, scanId);
          allow update: if isValidId(userId) && isValidId(scanId) && isValidId(hotspotId) &&
            isVerified() && isOwner(userId) &&
            isValidPcbHotspotDoc(incoming(), userId, scanId, hotspotId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().scanId == existing().scanId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'hotspotId', 'label', 'severity', 'bbox',
              'suspectComponentRef', 'notes', 'source', 'updatedAt'
            ]) &&
            ownsPcbScanAfter(userId, scanId);
          allow delete: if isValidId(userId) && isValidId(scanId) && isValidId(hotspotId) &&
            isVerified() && isOwner(userId) && ownsPcbScanExisting(userId, scanId);
        }
      }

      // Per-User Diagnostic Workflow Preferences & Synced Voice Macros Subcollection
      match /benchPreferences/{prefId} {
        allow get: if isValidId(userId) && isValidId(prefId) && prefId == 'preferences' && isVerified() && isOwner(userId);
        allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(prefId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidBenchPreferences(incoming(), userId, prefId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(prefId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidBenchPreferences(incoming(), userId, prefId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'workflowCheckedIds', 'preBenchGateLocked', 'autoVerifyWorkflow',
            'voiceMacroCount', 'schemaVersion', 'updatedAt',
            // Permitted solely for legacy v1 field deletion (isValidBenchPreferences forbids retaining it)
            'voiceMacros'
          ]);
        allow delete: if isValidId(userId) && isValidId(prefId) && prefId == 'preferences' && isVerified() && isOwner(userId);

        match /voiceMacros/{macroId} {
          allow get: if isValidId(userId) && isValidId(prefId) && isValidId(macroId) &&
            isVerified() && isOwner(userId) && ownsPrefsExisting(userId, prefId);
          allow list: if isVerified() && isOwner(userId) && prefId == 'preferences' && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(prefId) && isValidId(macroId) &&
            isVerified() && isOwner(userId) &&
            isValidVoiceMacroDoc(incoming(), userId, prefId, macroId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            ownsPrefsAfter(userId, prefId);
          allow update: if isValidId(userId) && isValidId(prefId) && isValidId(macroId) &&
            isVerified() && isOwner(userId) &&
            isValidVoiceMacroDoc(incoming(), userId, prefId, macroId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().prefId == existing().prefId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'triggerPhrase', 'steps', 'description', 'isPreset',
              'macroCreatedAtMs', 'macroUpdatedAtMs', 'updatedAt'
            ]) &&
            ownsPrefsAfter(userId, prefId);
          allow delete: if isValidId(userId) && isValidId(prefId) && isValidId(macroId) &&
            isVerified() && isOwner(userId) && ownsPrefsExisting(userId, prefId);
        }
      }

      // Saved Custom Fault Builder Sequences (Header + Validated Stages & Items Subcollections)
      match /faultSequences/{sequenceId} {
        allow get: if isValidId(userId) && isValidId(sequenceId) && isVerified() && isOwner(userId);
        allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sequenceId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidFaultSequence(incoming(), userId, sequenceId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(sequenceId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidFaultSequence(incoming(), userId, sequenceId) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'description', 'difficulty', 'loopPlayback', 'blindChallengeHint',
            'stageCount', 'itemCount', 'schemaVersion', 'sequenceUpdatedAtMs', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && isValidId(sequenceId) && isVerified() && isOwner(userId);

        match /stages/{stageId} {
          allow get: if isValidId(userId) && isValidId(sequenceId) && isValidId(stageId) &&
            isVerified() && isOwner(userId) && ownsFaultSequenceExisting(userId, sequenceId);
          allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(sequenceId) && isValidId(stageId) &&
            isVerified() && isOwner(userId) &&
            isValidFaultSequenceStageDoc(incoming(), userId, sequenceId, stageId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            ownsFaultSequenceAfter(userId, sequenceId);
          allow update: if isValidId(userId) && isValidId(sequenceId) && isValidId(stageId) &&
            isVerified() && isOwner(userId) &&
            isValidFaultSequenceStageDoc(incoming(), userId, sequenceId, stageId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().sequenceId == existing().sequenceId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'orderIndex', 'name', 'durationSec', 'notes', 'itemCount', 'updatedAt'
            ]) &&
            ownsFaultSequenceAfter(userId, sequenceId);
          allow delete: if isValidId(userId) && isValidId(sequenceId) && isValidId(stageId) &&
            isVerified() && isOwner(userId) && ownsFaultSequenceExisting(userId, sequenceId);
        }

        match /items/{itemId} {
          allow get: if isValidId(userId) && isValidId(sequenceId) && isValidId(itemId) &&
            isVerified() && isOwner(userId) && ownsFaultSequenceExisting(userId, sequenceId);
          allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(userId) && isValidId(sequenceId) && isValidId(itemId) &&
            isVerified() && isOwner(userId) &&
            isValidFaultSequenceItemDoc(incoming(), userId, sequenceId, itemId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            ownsFaultSequenceAfter(userId, sequenceId);
          allow update: if isValidId(userId) && isValidId(sequenceId) && isValidId(itemId) &&
            isVerified() && isOwner(userId) &&
            isValidFaultSequenceItemDoc(incoming(), userId, sequenceId, itemId) &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().sequenceId == existing().sequenceId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stageId', 'orderIndex', 'pinId', 'wireId', 'mode', 'label',
              'startOhms', 'endOhms', 'onDurationMs', 'offDurationMs',
              'intermittentEffect', 'updatedAt'
            ]) &&
            ownsFaultSequenceAfter(userId, sequenceId);
          allow delete: if isValidId(userId) && isValidId(sequenceId) && isValidId(itemId) &&
            isVerified() && isOwner(userId) && ownsFaultSequenceExisting(userId, sequenceId);
        }
      }
    }
  }
}
