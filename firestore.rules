    }

    // Users private profile (PII isolated strictly to verified owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerified() && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isVerified() &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isVerified() &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;

      // Saved Bench Sessions (Header + Individual Validated Subcollections)
      match /benchSessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && isVerified() && isOwner(userId);
        allow list: if isVerified() && isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(sessionId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidBenchSession(incoming(), userId, sessionId) &&
